    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@mediabunny/mp3-encoder": "^1.66.2",
    "@nozbe/microfuzz": "^1.0.0",
