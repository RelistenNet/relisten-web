    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tailwindcss": "^1.17.2",
    "postcss": "^8.5.33",
    "satteri": "^0.11.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-satteri": "^0.3.13",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*": "oxfmt --write --ignore-path .gitignore --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.16.1"
