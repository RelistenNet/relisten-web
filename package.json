    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@switz/driver": "0.10.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@timber-js/app": "0.2.0-alpha.252",
    "@xstate/react": "6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "css-anchor-kit": "^1.4.0",
    "date-fns": "^4.4.0",
    "gapless": "5.0.0-alpha.3",
    "isomorphic-fetch": "3.0.0",
    "ky": "^2.2.0",
    "lucide-react": "^1.76.0",
    "mediabunny": "^1.66.2",
    "node-device-detector": "^2.2.9",
    "nuqs": "^2.10.3",
    "react": "19.3.1",
