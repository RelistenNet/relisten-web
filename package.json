    "slugify": "^1.6.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "takumi-js": "^2.20.0",
    "tw-animate-css": "^1.4.0",
    "xstate": "^5.33.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@content-collections/core": "^0.15.3",
    "@content-collections/vite": "^0.3.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@switz/lint-config": "^14.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/mdast": "^4.0.4",
