{
  "name": "relisten-web",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "author": "Daniel Saewitz",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "timber dev",
    "dev:session": "RELISTEN_WEB_SESSION=1 NODE_OPTIONS=--use-system-ca timber dev",
    "build": "NODE_ENV=production vite build",
    "start": "timber preview",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "git config --local core.hooksPath .githooks || true",
    "gen:api": "orval",
    "setup:browser-session": "node scripts/setup-browser-session.mjs",
    "update:api": "curl -fsS https://api.relisten.net/api-docs/v4/swagger.json | node -e \"process.stdout.write(JSON.stringify(JSON.parse(require('fs').readFileSync(0,'utf8')),null,2)+'\\n')\" > src/api/swagger.json && orval"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
